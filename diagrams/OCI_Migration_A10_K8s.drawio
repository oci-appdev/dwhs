<mxfile host="app.diagrams.net" modified="2025-01-01T00:00:00.000Z" agent="architecture" version="24.0.0" type="device"><diagram name="OCI Migration - A10.2 K8s" id="oci-a10-k8s"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Migration to OCI — VM.GPU.A10.2 Node Pool Hosting DataWalk + HyperScience on Kubernetes" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1640" height="32" as="geometry"/></mxCell><mxCell id="t2" value="OC2 Realm · FedRAMP High / DISA IL4 · US Gov East (Ashburn) · Single OKE cluster, GPU-enabled worker nodes" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1640" height="22" as="geometry"/></mxCell><mxCell id="srcG" value="ON-PREMISES — CURRENT STATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;strokeWidth=2;dashed=0;verticalAlign=top;fontSize=15;fontStyle=1;fontColor=#333333;arcSize=4;" vertex="1" parent="1"><mxGeometry x="30" y="95" width="350" height="600" as="geometry"/></mxCell><mxCell id="srcH" value="Docker Swarm (multi-node)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="132" width="310" height="34" as="geometry"/></mxCell><mxCell id="dw1" value="&lt;b&gt;DataWalk&lt;/b&gt;&lt;br/&gt;13 servers&lt;br/&gt;~80 cores · 581 GB RAM&lt;br/&gt;11.4 TB storage&lt;br/&gt;&lt;i&gt;graph analytics · CPU only&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="180" width="310" height="120" as="geometry"/></mxCell><mxCell id="hs1" value="&lt;b&gt;HyperScience&lt;/b&gt;&lt;br/&gt;5 servers&lt;br/&gt;~52 cores · 205 GB RAM&lt;br/&gt;3.6 TB storage&lt;br/&gt;&lt;i&gt;document processing&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="314" width="310" height="120" as="geometry"/></mxCell><mxCell id="src2" value="&lt;b&gt;No GPU present today&lt;/b&gt;&lt;br/&gt;GPU is a new requirement introduced by the target design." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="448" width="310" height="58" as="geometry"/></mxCell><mxCell id="src3" value="&lt;b&gt;Totals:&lt;/b&gt; 18 servers · 132 cores · 786 GB RAM · ~15 TB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="520" width="310" height="48" as="geometry"/></mxCell><mxCell id="src4" value="Heavily over-provisioned — right-sizing opportunity on migration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="582" width="310" height="44" as="geometry"/></mxCell><mxCell id="migG" value="MIGRATION PATH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D6B656;strokeWidth=2;dashed=0;verticalAlign=top;fontSize=15;fontStyle=1;fontColor=#8A6D1F;arcSize=4;" vertex="1" parent="1"><mxGeometry x="410" y="95" width="250" height="600" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;1 · Assess&lt;/b&gt;&lt;br/&gt;Dependency map, K8s artifacts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="428" y="140" width="214" height="72" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;2 · Convert&lt;/b&gt;&lt;br/&gt;Swarm → Kubernetes manifests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="428" y="230" width="214" height="72" as="geometry"/></mxCell><mxCell id="me1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b&gt;3 · Provision&lt;/b&gt;&lt;br/&gt;EBLZ landing zone + OKE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="428" y="320" width="214" height="72" as="geometry"/></mxCell><mxCell id="me2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m4" value="&lt;b&gt;4 · Migrate data&lt;/b&gt;&lt;br/&gt;Block Volume + Object Storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="428" y="410" width="214" height="72" as="geometry"/></mxCell><mxCell id="me3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="m3" target="m4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m5" value="&lt;b&gt;5 · Cutover&lt;/b&gt;&lt;br/&gt;Non-prod first, then prod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="428" y="500" width="214" height="72" as="geometry"/></mxCell><mxCell id="me4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="m4" target="m5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m6" value="&lt;b&gt;6 · Validate&lt;/b&gt;&lt;br/&gt;Health, GPU scheduling, quotas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="428" y="590" width="214" height="72" as="geometry"/></mxCell><mxCell id="me5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="m5" target="m6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tgtG" value="OCI US GOV EAST — ASHBURN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;verticalAlign=top;fontSize=15;fontStyle=1;fontColor=#1F3864;arcSize=4;" vertex="1" parent="1"><mxGeometry x="690" y="95" width="980" height="930" as="geometry"/></mxCell><mxCell id="tgtH" value="Virtual Cloud Network — private subnets · network security groups" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="712" y="132" width="936" height="32" as="geometry"/></mxCell><mxCell id="lb" value="Flexible Load Balancer  ·  OCI DNS traffic management" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="712" y="176" width="936" height="38" as="geometry"/></mxCell><mxCell id="okeG" value="OKE CLUSTER (Enhanced) — single cluster, GPU-enabled node pool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82B366;strokeWidth=2;dashed=0;verticalAlign=top;fontSize=15;fontStyle=1;fontColor=#2C7A4B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="712" y="228" width="936" height="510" as="geometry"/></mxCell><mxCell id="okeH" value="Node pool shape: VM.GPU.A10.2  ·  2 nodes, one per fault domain (same AD)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2C7A4B;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="266" width="900" height="30" as="geometry"/></mxCell><mxCell id="n1G" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F4763;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="730" y="306" width="440" height="410" as="geometry"/></mxCell><mxCell id="n1H" value="NODE 1 — VM.GPU.A10.2  (Fault Domain 1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3D5A80;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="742" y="316" width="416" height="30" as="geometry"/></mxCell><mxCell id="n1s" value="2 × NVIDIA A10 (24 GB each)  ·  30 OCPU  ·  480 GB RAM  ·  block storage only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F7;strokeColor=#9CB0C8;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="742" y="352" width="416" height="32" as="geometry"/></mxCell><mxCell id="n1dw" value="&lt;b&gt;DataWalk pods&lt;/b&gt;&lt;br/&gt;graph analytics workload&lt;br/&gt;nodeSelector: workload=cpu&lt;br/&gt;&lt;i&gt;consumes node CPU + memory&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="742" y="392" width="416" height="92" as="geometry"/></mxCell><mxCell id="n1hs" value="&lt;b&gt;HyperScience pods&lt;/b&gt;&lt;br/&gt;document processing workload&lt;br/&gt;toleration: nvidia.com/gpu&lt;br/&gt;&lt;i&gt;consumes the 2 × A10 accelerators&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="742" y="492" width="416" height="92" as="geometry"/></mxCell><mxCell id="n1p" value="NVIDIA device plugin (DaemonSet) — exposes GPUs to the scheduler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E9F8;strokeColor=#B79FD6;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="742" y="592" width="416" height="32" as="geometry"/></mxCell><mxCell id="n1n" value="Both workloads co-resident · separated by labels, taints and resource limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="742" y="632" width="416" height="34" as="geometry"/></mxCell><mxCell id="n1cni" value="OCI VCN-native CNI  ·  kubelet  ·  container runtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F7;strokeColor=#9CB0C8;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="742" y="674" width="416" height="30" as="geometry"/></mxCell><mxCell id="n2G" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F4763;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1190" y="306" width="440" height="410" as="geometry"/></mxCell><mxCell id="n2H" value="NODE 2 — VM.GPU.A10.2  (Fault Domain 2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3D5A80;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1202" y="316" width="416" height="30" as="geometry"/></mxCell><mxCell id="n2s" value="2 × NVIDIA A10 (24 GB each)  ·  30 OCPU  ·  480 GB RAM  ·  block storage only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F7;strokeColor=#9CB0C8;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1202" y="352" width="416" height="32" as="geometry"/></mxCell><mxCell id="n2dw" value="&lt;b&gt;DataWalk pods&lt;/b&gt;&lt;br/&gt;replica set across fault domains&lt;br/&gt;nodeSelector: workload=cpu&lt;br/&gt;&lt;i&gt;consumes node CPU + memory&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1202" y="392" width="416" height="92" as="geometry"/></mxCell><mxCell id="n2hs" value="&lt;b&gt;HyperScience pods&lt;/b&gt;&lt;br/&gt;document processing workload&lt;br/&gt;toleration: nvidia.com/gpu&lt;br/&gt;&lt;i&gt;consumes the 2 × A10 accelerators&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1202" y="492" width="416" height="92" as="geometry"/></mxCell><mxCell id="n2p" value="NVIDIA device plugin (DaemonSet) — exposes GPUs to the scheduler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E9F8;strokeColor=#B79FD6;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1202" y="592" width="416" height="32" as="geometry"/></mxCell><mxCell id="n2n" value="Losing one fault domain leaves the other node serving both apps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1202" y="632" width="416" height="34" as="geometry"/></mxCell><mxCell id="n2cni" value="OCI VCN-native CNI  ·  kubelet  ·  container runtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F7;strokeColor=#9CB0C8;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1202" y="674" width="416" height="30" as="geometry"/></mxCell><mxCell id="haE" value="active / active HA pair" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#B85450;dashed=1;startArrow=block;startFill=1;endArrow=block;endFill=1;fontSize=11;fontColor=#B85450;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n1G" target="n2G"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="stG" value="PERSISTENT &amp; SHARED SERVICES  —  local node storage is not used for persistence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4AA78E;strokeWidth=2;dashed=0;verticalAlign=top;fontSize=15;fontStyle=1;fontColor=#0F6E56;arcSize=4;" vertex="1" parent="1"><mxGeometry x="712" y="752" width="936" height="150" as="geometry"/></mxCell><mxCell id="bv1" value="&lt;b&gt;Block Volume&lt;/b&gt;&lt;br/&gt;NVMe-backed PVCs&lt;br/&gt;DataWalk · 11.4 TB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="730" y="790" width="215" height="96" as="geometry"/></mxCell><mxCell id="bv2" value="&lt;b&gt;Block Volume&lt;/b&gt;&lt;br/&gt;NVMe-backed PVCs&lt;br/&gt;HyperScience · 3.6 TB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="957" y="790" width="215" height="96" as="geometry"/></mxCell><mxCell id="obj" value="&lt;b&gt;Object Storage&lt;/b&gt;&lt;br/&gt;live + backup buckets&lt;br/&gt;18 TB both apps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1184" y="790" width="215" height="96" as="geometry"/></mxCell><mxCell id="svc" value="&lt;b&gt;Platform services&lt;/b&gt;&lt;br/&gt;OCI Vault · OCIR registry&lt;br/&gt;IAM · Logging · Cloud Guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1411" y="790" width="215" height="96" as="geometry"/></mxCell><mxCell id="warn" value="&lt;b&gt;SIZING CHECK REQUIRED:&lt;/b&gt;  2 × VM.GPU.A10.2 provides 60 OCPU and 960 GB RAM in total. Measured demand across both applications is ~132 OCPU / 786 GB. CPU capacity is short by roughly half — either scale the node pool (4+ nodes), add a CPU-only node pool for DataWalk, or move to a larger GPU shape." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=left;spacingLeft=8;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="712" y="916" width="936" height="72" as="geometry"/></mxCell><mxCell id="e_src_mig" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="srcG" target="migG"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_mig_tgt" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="migG" target="tgtG"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lgG" value="LEGEND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=2;dashed=0;verticalAlign=top;fontSize=15;fontStyle=1;fontColor=#333333;arcSize=4;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="350" height="270" as="geometry"/></mxCell><mxCell id="lg1" value="DataWalk workload / pods" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="760" width="310" height="30" as="geometry"/></mxCell><mxCell id="lg2" value="HyperScience workload / pods" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="798" width="310" height="30" as="geometry"/></mxCell><mxCell id="lg3" value="GPU enablement (device plugin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E9F8;strokeColor=#B79FD6;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="836" width="310" height="30" as="geometry"/></mxCell><mxCell id="lg4" value="Persistent storage / platform services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="874" width="310" height="30" as="geometry"/></mxCell><mxCell id="lg5" value="Action required / open item" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="912" width="310" height="30" as="geometry"/></mxCell><mxCell id="lg6" value="Both apps share one OKE cluster; GPU pods are pinned to GPU nodes via taints and tolerations." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="946" width="310" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>