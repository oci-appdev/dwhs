=#312D2A;strokeWidth=1;endArrow=block;endFill=1;fontSize=10;fontColor=#312D2A;" edge="1" parent="1" source="lb" target="fd1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#312D2A;strokeWidth=1;endArrow=block;endFill=1;fontSize=10;fontColor=#312D2A;" edge="1" parent="1" source="lb" target="fd2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#312D2A;strokeWidth=1;endArrow=block;endFill=1;fontSize=10;fontColor=#312D2A;" edge="1" parent="1" source="n1" target="bv1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#312D2A;strokeWidth=1;endArrow=block;endFill=1;fontSize=10;fontColor=#312D2A;" edge="1" parent="1" source="n2" target="bv2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="wn" value="&lt;b&gt;Sizing check.&lt;/b&gt;  Two VM.GPU.A10.2 nodes provide 60 OCPU and 960 GB RAM combined. Measured demand across both applications is approximately 132 OCPU and 786 GB. Memory is sufficient; CPU is short by roughly half. Resolve by scaling the node pool, adding a CPU-only node pool for DataWalk, or selecting a larger GPU shape." style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#C74634;strokeWidth=1;fontSize=11;fontColor=#312D2A;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="876" width="1090" height="52" as="geometry"/></mxCell><mxCell id="icn" value="&lt;b&gt;Official OCI icons.&lt;/b&gt;  This diagram uses neutral shapes so it renders anywhere. To apply Oracle's icon set: draw.io → File → Open Library from → URL, then load Oracle's OCI draw.io icon library and drag the matching icons onto each node." style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#312D2A;strokeWidth=1;fontSize=11;fontColor=#312D2A;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="410" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>