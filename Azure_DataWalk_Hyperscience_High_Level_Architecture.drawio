        <mxCell id="cell-55" value="Deploy DataWalk Dev-equivalent and Hyperscience Dev-equivalent first. Prod and remaining environments are target-state planning views, subject to vendor sizing and security authorization." style="text;html=1;whiteSpace=wrap;overflow=hidden;verticalAlign=middle;align=left;fontFamily=Arial;fontSize=13;fontColor=#42526E;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
