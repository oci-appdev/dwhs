        <mxCell id="cell-53" value="Production and non-production use separate subscriptions, spokes, clusters, storage, secrets, ingress and operational lifecycles. Shared hub services provide controlled connectivity without combining application workers." style="text;html=1;whiteSpace=wrap;overflow=hidden;verticalAlign=middle;align=left;fontFamily=Arial;fontSize=13;fontColor=#42526E;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
